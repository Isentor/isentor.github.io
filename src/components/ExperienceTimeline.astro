---
import type { ExperienceItem } from '../data/portfolio';

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props;
---

<section id="experience" class="experience light-section section-shell">
  <div class="container experience-layout">
    <div class="section-heading section-heading-sticky" data-reveal>
      <span class="micro-label">BACKGROUND</span>
      <h2>Experience</h2>
      <p>A concise view of the practical experience behind my current technical focus.</p>
    </div>

    <ol class="timeline">
      {items.map((item) => (
        <li data-reveal>
          <span class="timeline-period">{item.period}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
