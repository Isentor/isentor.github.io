---
import { externalLinks } from '../data/portfolio';
import HeroShowcase from './HeroShowcase.astro';
---

<section id="top" class="hero dark-section">
  <div class="container hero-grid">
    <div class="hero-copy" data-reveal>
      <span class="micro-label">PORTFOLIO / 2026</span>
      <h1>Maurycy Pytel</h1>
      <p class="hero-descriptor">Web Development & Automation</p>
      <p class="hero-lead">I build web platforms and automation tools that simplify complex workflows and keep results verifiable.</p>
      <p class="hero-support">My work combines WordPress, Python and system integration with hands-on experience in e-commerce, analytics and digital operations.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#projects">View projects</a>
        <a class="button button-secondary" href={externalLinks.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>

    <div class="hero-visual" data-reveal>
      <HeroShowcase />
    </div>
  </div>
</section>
