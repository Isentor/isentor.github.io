---
const isHomepage = Astro.url.pathname === '/';
const sections = ['Projects', 'Expertise', 'Experience', 'About', 'Contact'];
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="premium-header">
  <div class="premium-wrap premium-nav">
    <a class="premium-brand" href={isHomepage ? '#top' : '/'}>Maurycy Pytel</a>
    <nav aria-label="Primary navigation">
      {sections.map(section => <a href={`${isHomepage ? '' : '/'}#${section.toLowerCase()}`}>{section}</a>)}
    </nav>
  </div>
</header>
