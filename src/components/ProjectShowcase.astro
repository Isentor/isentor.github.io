---
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const isReversed = index % 2 === 1;
const number = String(index + 1).padStart(2, '0');
const image =
  project.image && project.imageAlt && project.imageWidth && project.imageHeight
    ? {
        src: project.image,
        alt: project.imageAlt,
        width: project.imageWidth,
        height: project.imageHeight,
      }
    : undefined;
---

<article class:list={['project-showcase', { 'project-showcase-reversed': isReversed }]} data-reveal>
  <div class="project-copy">
    <div class="project-kicker">
      <span>{number}</span>
      <span class="micro-label">{project.category}</span>
    </div>
    <h3>{project.name}</h3>
    <p>{project.description}</p>
    {project.details && <p>{project.details}</p>}
    <ul class="technology-list" aria-label={`${project.name} technologies`}>
      {project.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
    <div class="project-actions">
      {
        project.liveUrl && project.liveLabel && (
          <a class="project-live-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer">
            {project.liveLabel}
          </a>
        )
      }
      {
        project.caseStudyUrl && project.caseStudyLabel ? (
          <a class="project-case-study-link" href={project.caseStudyUrl}>{project.caseStudyLabel}</a>
        ) : (
          <span class="coming-soon">Case study coming soon</span>
        )
      }
    </div>
  </div>

  <div
    class:list={['project-visual', `project-visual-${project.visualType}`]}
    aria-hidden={image ? undefined : 'true'}
  >
    <div class="browser-frame">
      <div class="browser-bar" aria-hidden="true"><span></span><span></span><span></span><i></i></div>
      <div class:list={['browser-body', { 'browser-body-image': image }]}>
        {
          image ? (
            <img
              class="project-screenshot"
              src={image.src}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading="lazy"
              decoding="async"
            />
          ) : project.visualType === 'automation' ? (
            <>
              <span class="visual-label">{project.category}</span>
              <strong>{project.name}</strong>
              <div class="workflow-map">
                <span>Prepare</span><i></i><span>Validate</span><i></i><span>Schedule</span>
              </div>
            </>
          ) : (
            <>
              <span class="visual-label">{project.category}</span>
              <strong>{project.name}</strong>
              <div class="site-blueprint">
                <span></span>
                <div><i></i><i></i><i></i></div>
                <span></span>
              </div>
            </>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .project-case-study-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 1.1rem;
    border: 1px solid var(--accent-dark);
    color: var(--accent-text);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .project-case-study-link:hover {
    background: var(--accent-dark);
    color: var(--light);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-case-study-link:hover {
      transform: none;
    }
  }
</style>
